{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and role within the company.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "foreman", "laborer"] },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "Message": {
      "title": "Company Message",
      "description": "A message posted in the company-wide chat or board.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "createdAt": { "type": "number" },
        "projectId": { "type": "string" }
      },
      "required": ["text", "senderId", "createdAt"]
    },
    "Project": {
      "title": "Construction Project",
      "description": "Details about a specific jobsite.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "scope": { "type": "string" },
        "crewAssigned": { "type": "string" },
        "createdAt": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "pending"] },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "createdAt"]
    },
    "Calculation": {
      "title": "Saved Calculation",
      "description": "A saved mathematical result from a calculator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "calculatorKey": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "number" },
        "result": { "type": "object" },
        "ownerId": { "type": "string" }
      },
      "required": ["calculatorKey", "title", "result"]
    },
    "KnowledgeItem": {
      "title": "Knowledge Base Item",
      "description": "A document, plan, or note in the company library.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mimeType": { "type": "string" },
        "projectId": { "type": "string" },
        "createdAt": { "type": "number" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Company-wide or project-specific messages."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Master list of company projects."
    },
    "/calculations/{calculationId}": {
      "schema": "Calculation",
      "description": "Saved audit trails and mathematical outputs."
    },
    "/knowledge/{itemId}": {
      "schema": "KnowledgeItem",
      "description": "Company-wide blueprints and documentation."
    }
  }
}
