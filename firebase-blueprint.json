{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Construction project record",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "location": { "type": "string" },
        "scope": { "type": "string" },
        "crewAssigned": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["name", "createdAt"]
    },
    "PunchListItem": {
      "title": "Punch List Item",
      "description": "A task or issue to be addressed on a jobsite",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Completed"] },
        "assignedTo": { "type": "string" },
        "deadline": { "type": "integer" },
        "createdAt": { "type": "integer" }
      },
      "required": ["projectId", "title", "status", "createdAt"]
    },
    "DailyReport": {
      "title": "Daily Report",
      "description": "Summary of work completed in a day",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "date": { "type": "integer" },
        "workCompleted": { "type": "string" },
        "workerHours": { "type": "number" },
        "materialsUsed": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["projectId", "date", "ownerId", "createdAt"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Equipment or material tracked in inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "qrCode": { "type": "string" },
        "location": { "type": "string" },
        "assignedTo": { "type": "string" },
        "status": { "type": "string", "enum": ["In Stock", "In Use", "Maintenance", "Lost"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["name", "status", "createdAt"]
    },
    "Audit": {
      "title": "Audit",
      "description": "Safety or quality inspection",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "integer" },
        "inspector": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Completed"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["projectId", "type", "date", "status", "createdAt"]
    },
    "SafetyBriefing": {
      "title": "Safety Briefing",
      "description": "A safety topic discussed with the crew",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "integer" },
        "content": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["title", "date", "createdAt"]
    },
    "RFI": {
      "title": "RFI",
      "description": "Request for Information",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "number": { "type": "string" },
        "title": { "type": "string" },
        "question": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "In Review", "Answered", "Closed"] },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["projectId", "title", "question", "status", "priority", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": { "schema": "Project", "description": "Projects" },
    "/punch_lists/{punchId}": { "schema": "PunchListItem", "description": "Punch Lists" },
    "/daily_reports/{reportId}": { "schema": "DailyReport", "description": "Daily Reports" },
    "/inventory/{itemId}": { "schema": "InventoryItem", "description": "Inventory" },
    "/audits/{id}": { "schema": "Audit", "description": "Audits" },
    "/safety_briefings/{id}": { "schema": "SafetyBriefing", "description": "Safety Briefings" },
    "/rfis/{id}": { "schema": "RFI", "description": "RFIs" }
  }
}
