rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidProfile(data) {
      return data.keys().hasAll(['userId', 'preferredUnits'])
        && data.userId == request.auth.uid
        && data.preferredUnits is string && data.preferredUnits.size() <= 20;
    }

    function isValidCalculation(data) {
      return data.keys().hasAll(['userId', 'calculatorKey', 'calculatorVersion', 'inputJson', 'resultJson', 'sharedScope'])
        && data.userId == request.auth.uid
        && data.calculatorKey is string && data.calculatorKey.size() <= 60
        && data.calculatorVersion is string && data.calculatorVersion.size() <= 20
        && data.inputJson is string && data.inputJson.size() <= 100000
        && data.resultJson is string && data.resultJson.size() <= 100000
        && data.sharedScope is string && data.sharedScope.size() <= 20;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidProfile(incoming());
    }

    match /calculations/{calcId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid && isValidId(calcId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(calcId) && isValidCalculation(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid && isValidId(calcId);
    }
  }
}
